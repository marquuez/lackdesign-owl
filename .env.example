# Lackdesign Portal — Umgebungsvariablen
# Kopieren: cp .env.example .env

# PostgreSQL (docker-compose + lokales npm run dev)
POSTGRES_PASSWORD=lackdesign-change-me
# Optional, sonst: postgresql://lackdesign:${POSTGRES_PASSWORD}@127.0.0.1:${LACKDESIGN_DB_PORT}/lackdesign
# DATABASE_URL=postgresql://lackdesign:lackdesign-change-me@127.0.0.1:5434/lackdesign

# App-Port auf dem Host
LACKDESIGN_PORT=8090
LACKDESIGN_DB_PORT=5434

# JWT für Admin-Login (min. 32 Zeichen in Produktion)
JWT_SECRET=lackdesign-jwt-secret-mindestens-32-zeichen!!
JWT_EXPIRES_IN=7d

# Erster Admin (wird beim Start angelegt, falls noch nicht vorhanden)
LACKDESIGN_ADMIN_EMAIL=admin@lackdesign.de
LACKDESIGN_ADMIN_PASSWORD=Mindestens8Zeichen!
LACKDESIGN_ADMIN_NAME=Lackdesigner

# Zugangscode für Anbieter-Formular (an Partner-Firma weitergeben)
# Link: https://ihre-domain.de/anbieter.html?token=HIER_DER_CODE
LACKDESIGN_PROVIDER_TOKEN=partner-geheimcode-2026

# Hinter nginx/Reverse-Proxy setzen
LACKDESIGN_TRUST_PROXY=0

# Öffentliche Kontaktdaten (Anrufen / Impressum)
LACKDESIGN_PHONE=
LACKDESIGN_MAIL=

# Strato-Mail (Kontaktformular)
# Host/Port laut STRATO: smtp.strato.de, 465 SSL oder 587 STARTTLS
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
